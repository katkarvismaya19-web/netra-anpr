# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/
env/

# Datasets (downloaded / generated - too large for git)
data/*
!data/.gitkeep
!data/README.md

# Training outputs (curves and logs are regenerated by the scripts)
outputs/*
!outputs/.gitkeep
runs/

# Fonts are downloaded automatically by scripts/generate_plates.py
assets/fonts/*.ttf

# Ultralytics base weights downloaded at training time
yolov8*.pt
yolo11*.pt

# Trained weights in models/ ARE committed so the dashboard works after cloning
# (plate_detector.pt ~6 MB, crnn_plate.pt ~30 MB). Uncomment to exclude them:
# models/*.pt

# Dashboard accounts (hashed passwords) - never commit
.streamlit/secrets.toml

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
